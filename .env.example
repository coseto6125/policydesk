# Port 5434 keeps this clear of enoract's local Postgres on 5433.
DATABASE_URL=postgres://policydesk:policydesk@localhost:5434/policydesk
LOG_LEVEL=INFO

# The model the desk talks to. Swap the key in without touching code.
OPENAI_API_KEY=
POLICYDESK_MODEL=gpt-5.6-luna

# The default when no OPENAI_API_KEY is set: Claude Code's subscription OAuth token,
# read from ~/.claude/.credentials.json. A host nobody is signed in on points this at a
# token file synced from one that is. The file is only ever read, never rewritten —
# Anthropic's refresh tokens rotate on use, so refreshing here would sign Claude Code out.
ANTHROPIC_OAUTH_CREDS_PATH=
POLICYDESK_ANTHROPIC_MODEL=claude-haiku-4-5
# anthropic | openai | codex. Unset picks the first this machine can run.
POLICYDESK_PROVIDER=
# Leave this unset and the server mints one per boot and logs it, which is safer than
# any value that could ship in a repo. Set it to keep the back office reachable at the
# same token across restarts.
POLICYDESK_DESK_TOKEN=

# Embeddings and reranking run on Cloudflare Workers AI, so the desk needs no local
# encoder and no LAN llama-server. Unset, the vector channel does not open and the
# desk answers on BM25 alone — a quieter and measurably worse demo, so set both.
# Both accept a comma-separated list; the client rotates to the next account when one
# account's daily free quota runs out.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AUTH_TOKEN=
POLICYDESK_CF_MODEL=@cf/baai/bge-m3

# The answering model reads a rotating subscription OAuth token from this file rather
# than an environment variable, because Claude Code refreshes it in the background and
# the desk re-reads it near expiry. Unset, it falls back to ~/.claude/.credentials.json,
# which exists only where Claude Code is logged in.
ANTHROPIC_OAUTH_CREDS_PATH=

# 訂閱憑證的副本，給 docker-compose.oci.yml 掛進容器。
#
# 放在部署目錄「外面」。放在裡面的時候，一次 `rsync -az --delete` 把它刪了——它不在
# repo 裡，所以 --delete 認定它多餘。Docker 接著在同名位置建了一個空目錄，容器讀不到，
# provider 靜靜退回 codex-cli，客戶端每一題收到「櫃台的語言服務目前無回應」。
#
# 權限要 640 加容器的群組（Dockerfile 是 uid 10001），不是 600：600 屬於部署帳號，
# 容器不是用那個帳號跑的。`scripts/sync-token.sh` 兩件事都做，而且推完會從容器裡讀一次
# 驗證——啟動訊息的 `provider_ready provider=anthropic` 只證明選型，不證明讀得到。
# 掛的是目錄不是檔案：bind mount 綁 inode，而同步是寫暫存檔再 rename，
# 容器會一直讀到啟動當下那一份。目錄裡的檔名固定是 anthropic-token.json。
ANTHROPIC_TOKEN_DIR=/home/ubuntu/policydesk-secrets
